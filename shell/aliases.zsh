# devkit aliases

# Kubernetes
alias kc='kubectl'

# Python
alias py='python3'
alias pip='pip3'

# Git - use GitHub CLI
alias gpr='gh pr create'
alias gpv='gh pr view --web'

# Quick navigation
alias ..='cd ..'
alias ...='cd ../..'

# Better defaults
alias grep='grep --color=auto'
alias ls='ls --color=auto'
